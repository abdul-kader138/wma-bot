APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail can also be fully configured from the admin panel (Settings -> Email),
# which takes precedence over these values once a SMTP host is set there.
# Example free provider: Brevo (https://app.brevo.com) SMTP relay, 300 emails/day free.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# WhatsApp Cloud API — shared across all numbers under the same Meta App
# (per-number phone_id/token are configured in the admin panel under WhatsApp
# Accounts). If a number lives under a *different* Meta App/Business account,
# set an "App Secret Override" on that account instead of a second env var —
# Meta signs each webhook with its own App's secret, so one shared value here
# can't cover accounts split across multiple Apps.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# Facebook Messenger — shared across all pages under the same Meta App
# (per-page id/token are configured in the admin panel under WhatsApp
# Accounts, same as WhatsApp; same per-account App Secret Override applies).
MESSENGER_VERIFY_TOKEN=
MESSENGER_APP_SECRET=

# Instagram Messaging — shared across all connected accounts under the same
# Meta App (same per-account App Secret Override applies).
INSTAGRAM_VERIFY_TOKEN=
INSTAGRAM_APP_SECRET=

# Anthropic / Claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Maria read-only Google Workspace connection. Register the callback URL shown
# below as an authorized redirect URI in the Google Cloud OAuth web client.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/panel-api/connectors/google/callback"
